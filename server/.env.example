# Local development. Production values live only in the host's journal.env.
PORT=8791
# DATABASE_URL=postgresql://journal_runtime:...@127.0.0.1:5432/journal   # unset = in-memory store
# openssl rand -base64 32  -> JOURNAL_DATA_KEYS=1:<that>
JOURNAL_DATA_KEYS=
# openssl rand -hex 32
SESSION_SECRET=
APPLE_BUNDLE_ID=com.jimgreco.journal
ALLOWED_EMAILS=
# ALLOWED_APPLE_SUBS=
# Simulator only, never in production:
JOURNAL_DEV_SIGNIN=1
# Weekly review (see docs/weekly-summary.md):
# WEEKLY_SUMMARY_TOKEN_SHA256=
# WEEKLY_SUMMARY_EMAIL=
# TRUST_PROXY_HOPS=1
